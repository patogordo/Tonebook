{
  "name": "tonebook",
  "description": "Timbres de músicas para a pedaleira LIVTRA NanoCore, enviados pelo navegador via USB MIDI",
  "license": "MIT",
  "repository": "github:patogordo/Tonebook",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3300",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "nuxt": "4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
}
